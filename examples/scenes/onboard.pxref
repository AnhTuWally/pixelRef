    {
      "id": "8455f7e9-3303-4fe0-922a-7df4f8625d9a",
      "name": "Explanation_3",
      "type": "annotation_text",
      "parent": "647c40db-4788-4ae5-a175-c82f1b65bc66",
      "attrs": {
        "tags": [],
        "translate": [
          1800,
          11186.928571428572
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "The canvas is endless. Scroll to zoom, hold Space or the middle mouse button and drag to pan.\n\n1   The minimap shows where the view sits on the whole board.\n2   Zoom bar: click the % for 100% (Ctrl+0), the arrow for presets, Fit to see everything.\n3   Markers save a view you can jump back to: Ctrl+1 … Ctrl+9.\n4   Workspaces (1, 2, 3 …) each keep their own layout of views.\n\nF frames the selection, Shift+F frames everything, and double-clicking a picture zooms to it. Tap Space to maximise a view.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
