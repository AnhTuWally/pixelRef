    {
      "id": "a2b8d0f6-640a-43d2-a709-c9f7ae06c015",
      "name": "Explanation_18",
      "type": "annotation_text",
      "parent": "a2b72405-e231-433a-8e15-85960e2af572",
      "attrs": {
        "tags": [],
        "translate": [
          3600,
          25571.492207792213
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Every colour swatch (Stroke, Fill, Text, Highlight, Border, the canvas background) opens a popover beside it.\n\n1   Click any colour swatch. Changes show on the canvas while you drag, and the whole edit is one undo step.\n2   The square sets saturation and brightness, the ring sets the hue. Sliders and fields set alpha, RGB, HSV and HSL.\n3   Type or paste a hex code such as #E07828 or rgb(224, 120, 40).\n4   The eyedropper picks a colour from anywhere on your screen, even another application.\n5   In this scene lists the colours already on your board, so a new item can match an old one.\n\nPrefer the classic dialog? Press Ctrl+K and type “picker” to switch back to the Qt colour dialog.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
