        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Steps are numbered markers: ideal for review comments and tutorials like this one.\n\n1   Press N and click. Each click places the next number.\n2   A tail can point at a detail. Drag the tail handle to aim it.\n3   Renumber from the Steps menu, or change the style to letters or roman numerals.\n\nPair each step with a text note, and your board reads like a checklist.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
