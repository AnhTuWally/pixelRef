    {
      "id": "571274cf-a945-451c-b475-af39c85758e7",
      "name": "Explanation_2",
      "type": "annotation_text",
      "parent": "3c2043e3-7270-4361-b5c4-a687e2879ec8",
      "attrs": {
        "tags": [],
        "translate": [
