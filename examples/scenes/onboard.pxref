    {
      "id": "cc4d79e3-6e55-411b-afd8-10dcab94ac5b",
      "name": "Explanation_19",
      "type": "annotation_text",
      "parent": "e3f2b231-8bdf-4010-9b53-5cfd4191fb26",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          27786.292207792212
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Pin a note, arrow or drawing to a single frame of a GIF or movie, so it only appears while that frame shows.\n\n1   Pause (K), step with , and . to a frame, then draw. Anything drawn on a paused frame is pinned to it. To pin an existing note, select it and press Alt+F.\n2   The filmstrip under the picture ticks each frame that has a note (amber) or a link (blue). Click a tick to jump there.\n3   A link drawn from a note onto the paused picture remembers the frame. Clicking that end jumps the GIF back to it.\n4   Ghost (Attribute Editor) also shows a note faintly on the frames either side. Show on All Frames un-pins it.\n\nPress play and watch the red box and arrow appear only on their own frames. Copy to Frames puts a copy of a note on a range of frames, for example 2-5.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
        "background_color": [
          0,
          0,
          0,
          0
        ],
        "fill_style": "solid",
        "border_color": [
          220,
          220,
          220,
          255
        ],
        "border_width": 0.0,
        "border_style": "solid",
        "corner_radius": 0.0,
        "padding": 4.0,
        "text_width": 652.1739130434784
      }
    },
