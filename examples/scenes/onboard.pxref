    {
      "id": "e9606766-91c2-437a-803c-a15c1070a584",
      "name": "Explanation",
      "type": "annotation_text",
      "parent": "a7cce8fd-ffad-408b-8c8d-79f51f73a4e9",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          4770.9
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "A new board is empty, and the start panel is your way in.\n\n1   Open… (Ctrl+O) loads a board. Boards you saved show up here as recent files, with a thumbnail.\n2   The start panel only shows on an empty board. F1 lists every shortcut.\n3   These tabs show or hide the Tools, Outliner and Attribute Editor panels.\n\nAdd images: paste with Ctrl+V (clipboard pictures and screenshots too), drag in files, folders, GIFs or videos, or press Ctrl+I.\nImages are embedded, so one .pxref file holds the whole board. PureRef .pur boards open too (File → Open PureRef Board).",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
        "background_color": [
          0,
