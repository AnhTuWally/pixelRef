    {
      "id": "65171b33-ac2a-4708-b19e-d203ca213b8f",
      "name": "Safety text",
      "type": "annotation_text",
      "parent": "583beab1-9bdc-41f2-95c0-9d12e4bcf200",
      "attrs": {
        "tags": [],
        "translate": [
          400,
          873.7
        ],
        "rotate": 0.0,
        "scale": [
          2.6,
          2.6
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Third-party plugins, scripts and Python packages run with your permissions: they can read and change your files, use the network and start other programs. Only install them from people you trust.\n\npixelRef won't run a new or changed plugin until you approve it in Window → Plugins….  Read Staying Safe (Ctrl+2) before you add one, or any time: right-click the canvas → Staying Safe with Plugins & Scripts….",
        "color": [
          240,
          232,
          214
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
