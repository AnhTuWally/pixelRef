    },
    {
      "id": "d3c7eb37-c77c-4e2f-86bf-449c07b188f2",
      "name": "How to read",
      "type": "annotation_text",
      "parent": "c3f1eff4-b16f-49ef-979a-7b1cd9901d05",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          708.5
        ],
        "rotate": 0.0,
        "scale": [
          2.6,
          2.6
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "How to read this guide\n\n•  Scroll to zoom. Hold Space (or the middle mouse button) and drag to pan.\n•  Ctrl+1 shows this welcome, Ctrl+2 the Basic Features and Ctrl+3 the Advanced Features. The Markers menu in a view's header jumps to any lesson.\n•  Each lesson is a screenshot with yellow numbered callouts. The numbers match the explanation under it.\n•  The “Your turn” cards and the framed areas on the lessons hold real pictures, notes and shapes to practise on. Text, backgrounds and screenshots are locked, so they stay put while you edit. This guide opens as an untitled copy, so nothing you do to it is kept unless you save it.\n\nSave and share\n\n•  Ctrl+S saves the whole board, pictures included, as one .pxref file. Ctrl+E exports an image, Ctrl+Alt+C copies the board (or the selection) to the clipboard.\n\nCome back any time\n\n•  Right-click the canvas and choose Getting Started…, press Ctrl+K and type “getting started”, or click Getting Started on the start panel of an empty board.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
        "background_color": [
          0,
          0,
          0,
          0
