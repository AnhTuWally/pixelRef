    {
      "id": "f80c6170-a6d9-406d-bd15-30b80e11ff61",
      "name": "Explanation_1",
      "type": "annotation_text",
      "parent": "923811c5-0bde-4d50-9ee6-763879f17250",
      "attrs": {
        "tags": [],
        "translate": [
          1800,
          7497.1
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Every third-party plugin in Window → Plugins… carries one of these signs.\n\n1   Green and blue: allowed to run. Signed by a publisher you trust, or approved by you with exactly these files.\n2   Amber: waiting for you. Ask who made it, where you got it, and why it needs what it asks for.\n3   Red: blocked. The files don't match the publisher's signature, so someone may have changed them. Don't approve it.\n\nRight-click the canvas → Staying Safe with Plugins & Scripts… opens the full guide: what pixelRef checks, what it can't, and what to do if something looks wrong.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
