    {
      "id": "92637a74-02a4-4f0a-aca5-1351d00217aa",
      "name": "How to read this guide text",
      "type": "annotation_text",
      "parent": "583beab1-9bdc-41f2-95c0-9d12e4bcf200",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          1664.7
        ],
        "rotate": 0.0,
        "scale": [
          2.6,
          2.6
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "•  Scroll to zoom. Hold Space (or the middle mouse button) and drag to pan.\n\n•  Each lesson is a card. A screenshot has yellow numbered callouts, and a live card has numbered dots on real items. The numbers match the explanation under it.\n\n•  Pictures, notes and shapes on a “live” card or a “Your turn” card are real: drag, edit and break them. Text, backgrounds and screenshots are locked, so they stay put. This guide opens as an untitled copy, so nothing you do to it is kept unless you save it.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
        "background_color": [
          0,
          0,
          0,
          0
        ],
        "fill_style": "solid",
        "border_color": [
          220,
          220,
          220,
          255
        ],
        "border_width": 0.0,
        "border_style": "solid",
        "corner_radius": 0.0,
        "padding": 4.0,
        "text_width": 596.1538461538462
      }
    },
