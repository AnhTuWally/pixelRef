    {
      "id": "19a76470-9caf-4cf1-81e8-cf36ff33c1d6",
      "name": "Explanation_6",
      "type": "annotation_text",
      "parent": "175099a9-220b-450e-b4e0-c289fc4bc3b0",
      "attrs": {
        "tags": [],
        "translate": [
          1800,
          13142.728571428572
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "G groups the selection, Ctrl+Shift+G ungroups. A group moves, scales and rotates as one.\n\n1   This pair is already a group. Drag one picture and both move.\n2   These two are loose. Shift+click both and press G to group them.\n3   Everything is listed in the Outliner: drag rows to reparent, F2 renames, the eye hides and the lock protects an item.\n\nCtrl+Alt+G arranges the selection in a grid. Tab hides the side panels for a clean canvas.\nThe lock in the Outliner is how this guide keeps its own text and backgrounds from moving while you edit.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
