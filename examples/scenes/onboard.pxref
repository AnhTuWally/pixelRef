    {
      "id": "dd583c9f-84a2-44fd-b01b-60c78735f812",
      "name": "Explanation_20",
      "type": "annotation_text",
      "parent": "62a785d9-cf15-46c8-9185-d22c540a6238",
      "attrs": {
        "tags": [],
        "translate": [
          1800,
          27906.292207792212
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Buttons, and any other item, can show, hide, move or change things when they're clicked. Everything in the frame is live: click the buttons.\n\n1   Click it to show the answer, and again to hide it. It was made by dragging the round handle beside a selected button onto the note and choosing Show.\n2   A button runs only when it's locked. Unlocked, a click selects it for editing, and Run in the bar under it tries it. These are locked: unlock one in the Outliner to edit it.\n3   Tabs: select a few pictures, right-click → Click Action → Make Tabs from Selection. One shows at a time.\n4   Demonstrated, not programmed: select a button, choose Demonstrate…, make the board look the way it should after the click (here: the GIF on frame 3), then press Done. The board goes back by itself.\n\nThe Attribute Editor's Click Action section says what a click does in plain words (“Go to frame 3 · reaction”). Try it runs it, Reset puts things back, and × removes a step.\nLock your buttons when the board is finished: that's what makes a plain click run them.\nAn amber dashed outline means a step didn't run, for example because its item was deleted. Right-click → Click Action → Click Action Log… says why.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
        "background_color": [
          0,
          0,
          0,
          0
        ],
        "fill_style": "solid",
        "border_color": [
          220,
          220,
          220,
          255
        ],
        "border_width": 0.0,
        "border_style": "solid",
        "corner_radius": 0.0,
        "padding": 4.0,
        "text_width": 652.1739130434784
      }
    },
