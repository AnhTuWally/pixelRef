    {
      "id": "67962f83-afde-4114-a226-9fa7f1d1f85a",
      "name": "Explanation_12",
      "type": "annotation_text",
      "parent": "ca04947e-cc59-4009-8423-ab42f983bc45",
      "attrs": {
        "tags": [],
        "translate": [
          1800,
          20494.728571428575
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Look at the same board in more than one way at once.\n\n1   Every view has its own camera, so one can stay zoomed out while another looks close.\n2   Display presets such as Value check show the board in greyscale, to judge contrast.\n3   A framing guide (16:9, 2.39:1 …) overlays the crop you are composing for.\n4   Switch workspaces from here, or press Ctrl+W then a number.\n\nCtrl+W starts the window manager: split, move and focus views from the keyboard.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
