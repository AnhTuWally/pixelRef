        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "GIFs and videos play right on the board. This one is already running.\n\n1   Select it and press K to pause or play. Step with , and . and jump to the ends.\n2   Click or drag along the filmstrip under the picture to scrub to a moment.\n3   It keeps its annotations: add a note or a frame and it stays put while the picture plays.\n\nMovies (mp4, mov, webm …) are always linked, never embedded: keep the video file next to the board.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
