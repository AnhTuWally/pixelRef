          2.6,
          2.6
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "•  Ctrl+1 is this welcome, Ctrl+2 Staying Safe, Ctrl+3 the Basic Features, Ctrl+4 the Advanced Features and Ctrl+5 the New Features. The Markers menu in a view's header lists every lesson, and clicking one flies you there.\n\n•  Press Shift+F to see the whole guide at once, then scroll in on the card you want.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
