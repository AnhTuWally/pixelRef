    {
      "id": "eb2dd14c-11a5-43de-95c6-842d53204e77",
      "name": "Explanation_14",
      "type": "annotation_text",
      "parent": "9f025e19-6148-4e21-af16-540b95f2e980",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          22550.728571428575
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Every action in pixelRef is a command, and the same commands can be called from Python.\n\n1   Results appear here. Echo shows the Python behind every click, so you can learn by watching.\n2   Type pxcmd.… and press Ctrl+Enter. Tab completes.\n3   Echo all commands turns your mouse work into a script you can reuse.\n\nOpen it with Ctrl+W then - . Scripts can also run headless: python -m pixelref --batch script.py.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
