        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Everything on this card is yours to play with. Nothing you do here can break the guide.\n\n1   Select a rectangle, press Ctrl+Alt+Shift+C, select a picture's note and press Ctrl+Alt+Shift+V.\n2   Shift+click several pictures and look for Shared attributes in the Attribute Editor.\n3   Press R, drag a box, then click its Stroke swatch to try the colour picker.\n4   Click the GIF, press K to pause it, step with . and draw a box on one frame. Press K to play.\n5   Select a picture, right-click → Click Action → Make Reveal Button, lock the new button in the Outliner and click it.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
