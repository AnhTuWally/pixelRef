    {
      "id": "fc9b95f9-c696-4587-8b60-21f6a12b9272",
      "name": "Explanation_11",
      "type": "annotation_text",
      "parent": "8fdd0351-2030-409a-af1c-9f7b044f0fcb",
      "attrs": {
        "tags": [],
        "translate": [
          3600,
