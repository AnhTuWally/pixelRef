    {
      "id": "e30cab69-f041-46be-a18c-8d6dcc1ebf8a",
      "name": "Explanation_11",
      "type": "annotation_text",
      "parent": "9f2203b6-9b46-4a70-b9ca-364a94d3ac21",
      "attrs": {
        "tags": [],
        "translate": [
