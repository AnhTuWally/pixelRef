          0,
          0
        ],
        "fill_style": "solid",
        "border_color": [
          220,
          220,
          220,
          255
        ],
        "border_width": 0.0,
        "border_style": "solid",
        "corner_radius": 0.0,
        "padding": 4.0,
        "text_width": 652.1739130434784
      }
