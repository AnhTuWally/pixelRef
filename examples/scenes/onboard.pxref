    {
      "id": "00d65af8-2246-43bd-954b-fe2e292c5e41",
      "name": "Explanation_9",
      "type": "annotation_text",
      "parent": "753879e9-3650-47cc-b700-586e4dc88f78",
      "attrs": {
        "tags": [],
        "translate": [
