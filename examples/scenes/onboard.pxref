    {
      "id": "a78cc20c-c532-4a8a-b3d1-8e879e0984a4",
      "name": "Tasks",
      "type": "annotation_text",
      "parent": "56e176af-155a-4c8a-964c-5af79b796b92",
      "attrs": {
        "tags": [],
