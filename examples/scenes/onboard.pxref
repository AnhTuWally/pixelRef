    {
      "id": "a6bc2f56-5a39-4669-90c3-241c1e45e39a",
      "name": "Tasks_1",
      "type": "annotation_text",
      "parent": "0eea7a81-9f32-4e46-a388-b7cf1b5ce03d",
      "attrs": {
        "tags": [],
        "translate": [
          3600,
          16225.063636363637
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Everything on this card is yours to play with. Nothing you do here can break the guide.\n\n1   Select a picture and add an Edge Detect effect in the Attribute Editor.\n2   Press B and drag over a face to blur it. Press X to pixelate instead.\n3   Press W and drag from one picture to another to link them.\n4   Press N and click to drop numbered Steps on the details you want to point out.\n5   Press Ctrl+W then N to open a second view of the same board.\n6   Press Ctrl+K and type “script” to open the Script Editor.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
