    {
      "id": "e0c03d61-0b48-483c-bfc2-16e2ad6a6d34",
      "name": "Explanation_6",
      "type": "annotation_text",
      "parent": "255ad5ca-f605-4e0b-b18b-3f4bc9a0007d",
      "attrs": {
        "tags": [],
        "translate": [
