    {
      "id": "3689c96f-9d0f-481d-b189-5992adc68077",
      "name": "Explanation_3",
      "type": "annotation_text",
      "parent": "66256451-1784-44a6-8a90-dcc104c75487",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          6726.700000000001
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Annotations are items too, so they move, scale and undo like pictures. Everything in the frame is live.\n\n1   Press R and drag for a rectangle, O for an ellipse. Blue dots on a shape's corners set the corner radius.\n2   Press T and click to type a note. Double-click text to edit it, drag the side handles to set its width.\n3   Press A and drag for an arrow. The quick-edit bar sets colour, thickness and arrowheads.\n4   Pick a tool in the Tools panel or press its key. Drawing tools stay active until you press Esc or V.\n\nA note made while one picture is selected is attached to it and travels with it.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
