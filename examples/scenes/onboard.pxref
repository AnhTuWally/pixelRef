    {
      "id": "aa294239-d773-4276-9a8d-c8c9895ff8fa",
      "name": "Explanation",
      "type": "annotation_text",
      "parent": "2cc52c00-e292-4a87-86f3-9384f946e71d",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          7658.528571428572
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Plugins, scripts and Python packages are code. They run inside pixelRef with your permissions: they can read and change your files, use the network and start other programs.\n\n1   The first time you open Window → Plugins…, this notice says what plugins can do. Read it, then click Got it.\n2   This line turns amber whenever a plugin is waiting for your review.\n3   Needs attention lists plugins that are new, changed, failing or doing more than they declared.\n4   Its trust sign: this one is “? Not reviewed”, so its code has never run (see S2).\n5   Who made it, whether it is signed, and what it says it will do: here, use the network. Read this before you approve anything.\n6   Nothing runs until you approve it. The approval dialog asks once more, and Cancel is the default.\n\nA plugin whose files change after you approved it stops until you approve it again.\nScripts, userSetup.py and Python packages aren't checked like plugins: only run code you wrote or got from someone you trust.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
        "background_color": [
          0,
          0,
          0,
          0
        ],
        "fill_style": "solid",
        "border_color": [
          220,
          220,
          220,
          255
        ],
        "border_width": 0.0,
        "border_style": "solid",
        "corner_radius": 0.0,
        "padding": 4.0,
        "text_width": 652.1739130434784
      }
    },
