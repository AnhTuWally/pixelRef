    {
      "id": "90986fdc-e133-4bdb-9045-f32c771db141",
      "name": "Explanation_16",
      "type": "annotation_text",
      "parent": "f5eed390-7750-4652-88b1-970b589317b7",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          25571.492207792213
        ],
        "rotate": 0.0,
        "scale": [
          2.3,
          2.3
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "Style one item, then give the same look to as many others as you like, and choose exactly what is copied.\n\n1   Search the list by attribute or group name, for example “color”.\n2   Tick a whole group, or All attributes. Geometry (position, size, rotation) starts closed and unticked.\n3   Only differences hides values the items already share, so you see what will really change.\n4   Value shows the current value, an arrow and the value it becomes. The canvas previews it as you tick.\n5   Paste is one undo step. Cancel puts everything back.\n\nSelect the source item, press Ctrl+Alt+Shift+C, select the targets and press Ctrl+Alt+Shift+V. The buttons are also in Attribute Editor → Appearance.\nAn item takes an attribute when it has the same name and type, so a rectangle's stroke can go onto an ellipse or an arrow. Paste Style Attributes pastes just the look, without the window.",
        "color": [
          226,
          229,
          235
        ],
        "runs": null,
        "font_family": "",
        "font_size": 14.0,
        "bold": false,
        "italic": false,
        "underline": false,
        "strike": false,
        "highlight_color": [
          255,
          235,
          59,
          0
        ],
        "align": "left",
        "background_color": [
          0,
          0,
          0,
