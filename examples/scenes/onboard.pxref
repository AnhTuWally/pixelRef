    {
      "id": "968a69b0-8182-4c81-90ce-68c96e02cec5",
      "name": "Jump around text",
      "type": "annotation_text",
      "parent": "583beab1-9bdc-41f2-95c0-9d12e4bcf200",
      "attrs": {
        "tags": [],
        "translate": [
