    {
      "id": "229a9dd6-c877-4025-b83a-2bcb30611c2d",
      "name": "Explanation_10",
      "type": "annotation_text",
      "parent": "cda6a957-87e9-4c7a-ae4f-7b6fec02740b",
      "attrs": {
        "tags": [],
        "translate": [
