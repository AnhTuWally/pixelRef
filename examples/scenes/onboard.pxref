    {
      "id": "9c5bb87b-2c4d-4625-8450-e639c807fca9",
      "name": "Tasks_2",
      "type": "annotation_text",
      "parent": "59462a60-96af-4ef8-81b0-9406a5133113",
      "attrs": {
        "tags": [],
        "translate": [
          3600,
