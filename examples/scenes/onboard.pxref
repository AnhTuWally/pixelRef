    {
      "id": "af549284-5b48-442b-93ab-fce75033b170",
      "name": "Lead",
      "type": "annotation_text",
      "parent": "c3f1eff4-b16f-49ef-979a-7b1cd9901d05",
      "attrs": {
        "tags": [],
        "translate": [
          0,
          408.5
        ],
        "rotate": 0.0,
        "scale": [
          3.0,
          3.0
        ],
        "pivot": [
          0.0,
          0.0
        ],
        "visibility": 1,
        "opacity": 1.0,
        "locked": 0,
        "text": "A reference board for everything you are looking at. This guide is itself a pixelRef board: pan, zoom and click around it just like you will your own.",
        "color": [
          205,
          210,
          220
        ],
