    {
      "id": "e7fb0e62-ba08-441d-944f-250f419866c0",
      "name": "Explanation_4",
      "type": "annotation_text",
      "parent": "5ed70871-2934-4936-8626-a097f008558f",
      "attrs": {
        "tags": [],
        "translate": [
          3600,
